<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Image Optimizer Tool"
           Manufacturer="IMIP"
           Version="$(var.ProductVersion)"
           UpgradeCode="6F0B5C1E-3A55-4B8E-9C43-2D7E4F1A9B21"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="Đã cài một phiên bản mới hơn của [ProductName]." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(var.PublishDir)ImageOptimizerTool.exe" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ImageOptimizerTool" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="Image Optimizer Tool" />
    </StandardDirectory>

    <Feature Id="Main" Title="Image Optimizer Tool" Level="1">
      <!-- Everything dotnet publish produced: app, self-contained .NET runtime, native
           x64 DLLs (pdfium, tesseract, leptonica, VC++ runtime), tessdata, tools\. -->
      <Files Directory="INSTALLFOLDER" Include="$(var.PublishDir)**" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <DirectoryRef Id="AppMenuFolder">
      <Component Id="StartMenuShortcut" Guid="9B3E2C47-6D1A-4F0E-8A2B-5C7D9E1F3A64">
        <Shortcut Id="AppShortcut" Name="Image Optimizer Tool"
                  Target="[INSTALLFOLDER]ImageOptimizerTool.exe" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\IMIP\ImageOptimizerTool" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Package>
</Wix>
