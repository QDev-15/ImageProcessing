<Project Sdk="Microsoft.NET.Sdk">

  <!-- Repeatable performance benchmark of import, thumbnail, preview and export. Run: dotnet run -c Release (args: pages=40 label=baseline). Results go to Bench/results. Synthetic data only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImageCoreService\ImageCoreService.csproj" />
  </ItemGroup>

</Project>
