<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ImageOptimizerTool</AssemblyName>
    <RootNamespace>ImageOptimizerTool</RootNamespace>
  </PropertyGroup>

  <!-- All codecs, PDF/TIFF packing, PDF splitting and TWAIN scanning live in
       ImageCoreService (shared with other projects); this project is just the WinForms
       front end. NuGet dependencies and the vendored tools\ encoders flow in through
       this reference. -->
  <ItemGroup>
    <ProjectReference Include="..\ImageCoreService\ImageCoreService.csproj" />
  </ItemGroup>

</Project>
