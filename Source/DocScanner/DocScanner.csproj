<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android only for now (no Mac for iOS). To add iOS later: append net10.0-ios here and
		     restore Platforms\iOS from the MAUI template (dotnet new maui). -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>DocScanner</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Platforms/Android/BitmapPixels.cs reads and writes bitmap memory directly (AndroidBitmap_lockPixels). -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>Doc Scanner</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>btk.docscanner</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!-- Release: every assembly compiled ahead of time with LLVM. Mono JIT / plain AOT code is slow for the image loops
	     (measured 2026-09-27, Release, emulator: edge detector 815 -> 481 ms per page, thumbnail 243 -> 153 ms); startup unchanged.
	     Cost: Release build ~12 min instead of ~4, APK 29 -> 42 MB for two ABIs (~21 MB per ABI in a Play bundle). Debug unaffected. -->
	<!-- Debug: JIT instead of the Mono interpreter MAUI turns on for C# Hot Reload. Interpreted, the image loops ran 10-30x
	     slower than Release (Note 10+ Debug build: 1-5 s per black-and-white preview; emulator: warp 2.7-7.3 s vs 0.2 s), so
	     editing felt slow whenever the app was started from Visual Studio. XAML Hot Reload still works; set true to get C#
	     Hot Reload back. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<UseInterpreter>false</UseInterpreter>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
		<EnableLLVM>true</EnableLLVM>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="1" Color="#1A5FD6" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1A5FD6" BaseSize="160,160" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<!-- MIT -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<!-- Apache-2.0 (AndroidX CameraX) / MIT (.NET bindings): the in-app document camera (Platforms/Android/Camera) -->
		<PackageReference Include="Xamarin.AndroidX.Camera.Camera2" Version="1.6.2" />
		<PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.6.2" />
		<PackageReference Include="Xamarin.AndroidX.Camera.View" Version="1.6.2" />
		<!-- CameraX pulls newer Fragment / Collection; keep their Kotlin-extension packages on the matching versions (NU1608) -->
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
		<PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ImageCore.Shared\ImageCore.Shared.csproj" />
		<ProjectReference Include="..\DocScanner.Core\DocScanner.Core.csproj" />
	</ItemGroup>

</Project>
