<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DocScanner.Views.PdfViewerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:DocScanner.ViewModels"
    xmlns:views="clr-namespace:DocScanner.Views"
    x:DataType="vm:PdfViewerViewModel"
    Title="{Binding Title}"
    BackgroundColor="#101010">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Khác" Command="{Binding MoreCommand}" Order="Primary">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="Icons" Glyph="{x:Static views:Icons.Share}" Size="22"
                                 Color="{AppThemeBinding Light=#37404D, Dark=#E0E0E0}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto,Auto">

        <!-- One page, rendered sharp for zooming: pinch / double tap to zoom, drag when zoomed, swipe for the other pages. -->
        <Grid IsClippedToBounds="True">
            <Image x:Name="Picture" Aspect="AspectFit" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="60,*,60" HeightRequest="56" BackgroundColor="{AppThemeBinding Light=White, Dark=#1C1C1E}">
            <views:ToolButton Icon="{x:Static views:Icons.ChevronLeft}" Text="" IconSize="28" IsEnabled="{Binding CanGoPrevious}"
                              Command="{Binding GoCommand}">
                <views:ToolButton.CommandParameter><x:Int32>-1</x:Int32></views:ToolButton.CommandParameter>
            </views:ToolButton>
            <Label Grid.Column="1" Text="{Binding PageText}" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light=#37404D, Dark=#E0E0E0}" />
            <views:ToolButton Grid.Column="2" Icon="{x:Static views:Icons.ChevronRight}" Text="" IconSize="28" IsEnabled="{Binding CanGoNext}"
                              Command="{Binding GoCommand}">
                <views:ToolButton.CommandParameter><x:Int32>1</x:Int32></views:ToolButton.CommandParameter>
            </views:ToolButton>
        </Grid>

        <views:AdBannerView Grid.Row="2" BackgroundColor="#101010" />
    </Grid>
</ContentPage>
