<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DocScanner.Views.ExportsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:DocScanner.ViewModels"
    xmlns:views="clr-namespace:DocScanner.Views"
    x:DataType="vm:ExportsViewModel"
    Title="PDF đã xuất"
    BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#121212}">

    <Grid RowDefinitions="Auto,*,Auto">
        <Label Text="{Binding Summary}" Margin="16,8,16,6" FontSize="12"
               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />

        <RefreshView Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding Files}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="8" Padding="24">
                        <Label Text="{x:Static views:Icons.Pdf}" FontFamily="Icons" FontSize="64" HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light=#B8C4D6, Dark=#4A5568}" />
                        <Label Text="Chưa có PDF nào" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="Mở một tài liệu và bấm &quot;Xuất PDF&quot; ở thanh dưới."
                               HorizontalOptions="Center" HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="1" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExportItem">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Xoá" BackgroundColor="#D32F2F" Command="{Binding DeleteCommand}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border StrokeThickness="0" Padding="16,10"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1C1C1E}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Label Text="{x:Static views:Icons.Pdf}" FontFamily="Icons" FontSize="32" TextColor="#E53935" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Name}" FontSize="14" FontFamily="OpenSansSemibold" LineBreakMode="MiddleTruncation" />
                                        <Label Text="{Binding Details}" FontSize="12"
                                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                                    </VerticalStackLayout>
                                    <!-- Share / save / open with another app / delete -->
                                    <Label Grid.Column="2" Text="{x:Static views:Icons.More}" FontFamily="Icons" FontSize="22" Padding="10,8"
                                           VerticalOptions="Center" TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding MenuCommand}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <views:AdBannerView Grid.Row="2" />
    </Grid>
</ContentPage>
