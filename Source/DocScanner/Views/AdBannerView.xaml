<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="DocScanner.Views.AdBannerView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:admob="clr-namespace:Plugin.AdMob;assembly=Plugin.AdMob"
    BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#121212}">

    <!-- Free tier only, hidden the instant Pro is bought (IAdsService.ShowAds, resolved in code-behind so any
         page can drop this in without its ViewModel knowing about ads at all). -->
    <admob:BannerAd x:Name="Banner" IsVisible="False" AdSize="SmartBanner" />
</ContentView>
