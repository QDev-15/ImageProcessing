<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DocScanner.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:DocScanner.ViewModels"
    xmlns:views="clr-namespace:DocScanner.Views"
    x:DataType="vm:SettingsViewModel"
    Title="Cài đặt"
    BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#121212}">

    <ContentPage.Resources>
        <Style x:Key="Section" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="Margin" Value="18,18,18,6" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        </Style>
        <Style x:Key="Card" TargetType="VerticalStackLayout">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1C1C1E}" />
            <Setter Property="Padding" Value="16,4" />
        </Style>
        <Style x:Key="Name" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#1F2937, Dark=#F3F4F6}" />
        </Style>
        <Style x:Key="Hint" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="0,0,0,24">

            <Label Text="GÓI PRO" Style="{StaticResource Section}" />
            <VerticalStackLayout Style="{StaticResource Card}" Spacing="8" Padding="16,12">
                <Label Text="{Binding LicenseSummaryText}" Style="{StaticResource Name}" FontFamily="OpenSansSemibold" />
                <Label Text="Bản Pro bỏ giới hạn số lần xuất PDF và xoá mọi quảng cáo, dùng vĩnh viễn, mua một lần." Style="{StaticResource Hint}"
                       IsVisible="{Binding IsFree}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding IsFree}">
                    <Button Text="{Binding ProPriceText, StringFormat='Mua Pro · {0}', TargetNullValue='Mua Pro'}"
                            Command="{Binding BuyProCommand}" IsEnabled="{Binding LicenseIdle}"
                            BackgroundColor="{StaticResource Primary}" TextColor="White" FontSize="13" HeightRequest="40" CornerRadius="20" />
                    <Button Grid.Column="1" Text="Khôi phục giao dịch" Command="{Binding RestorePurchasesCommand}"
                            IsEnabled="{Binding LicenseIdle}"
                            BackgroundColor="Transparent" BorderWidth="1" BorderColor="{StaticResource Primary}"
                            TextColor="{StaticResource Primary}" FontSize="12" HeightRequest="40" CornerRadius="20" />
                </Grid>
                <ActivityIndicator IsRunning="{Binding IsBusyWithLicense}" IsVisible="{Binding IsBusyWithLicense}" HeightRequest="24"
                                   Color="{StaticResource Primary}" />
            </VerticalStackLayout>

            <Label Text="CHỤP ẢNH" Style="{StaticResource Section}" />
            <VerticalStackLayout Style="{StaticResource Card}">
                <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Tự chụp khi giữ yên máy" Style="{StaticResource Name}" />
                        <Label Text="Camera trong app chụp khi thấy tờ giấy đứng yên khoảng 1 giây." Style="{StaticResource Hint}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding CameraAutoCapture}" OnColor="{StaticResource Primary}" />
                </Grid>
            </VerticalStackLayout>

            <Label Text="TÀI LIỆU" Style="{StaticResource Section}" />
            <VerticalStackLayout Style="{StaticResource Card}">
                <Label Text="Chạm vào trang để" Style="{StaticResource Name}" Margin="0,10,0,0" />
                <Picker ItemsSource="{Binding OpenModes}" SelectedIndex="{Binding OpenModeIndex}" Title="Chạm vào trang để" />
            </VerticalStackLayout>

            <Label Text="XUẤT PDF" Style="{StaticResource Section}" />
            <VerticalStackLayout Style="{StaticResource Card}">
                <Label Text="Chất lượng mặc định" Style="{StaticResource Name}" Margin="0,10,0,0" />
                <Picker ItemsSource="{Binding PdfQualities}" SelectedIndex="{Binding PdfQualityIndex}" Title="Chất lượng PDF" />
                <Label Text="Trang đen trắng: Nhỏ / Vừa lưu 1-bit (rất nhẹ), Cao giữ mép chữ mềm." Style="{StaticResource Hint}" Margin="0,0,0,10" />
            </VerticalStackLayout>

            <Label Text="CẬP NHẬT" Style="{StaticResource Section}" />
            <VerticalStackLayout Style="{StaticResource Card}" Spacing="6" Padding="16,10">
                <Label Text="{Binding VersionText}" Style="{StaticResource Name}" />
                <Label Text="{Binding UpdateHint}" Style="{StaticResource Hint}" />
                <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding CanUpdate}">
                    <Label Text="Tự động cập nhật lúc 01:00" Style="{StaticResource Name}" />
                    <Switch Grid.Column="1" IsToggled="{Binding AutoUpdate}" OnColor="{StaticResource Primary}" />
                </Grid>
                <Entry Text="{Binding UpdateUrl}" Placeholder="https://.../update.json" Keyboard="Url" FontSize="13"
                       IsEnabled="{Binding CanUpdate}" ReturnCommand="{Binding SaveUrlCommand}" Unfocused="OnUrlUnfocused" />
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{Binding UpdateStatus}" Style="{StaticResource Hint}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Kiểm tra ngay" Command="{Binding CheckNowCommand}" IsEnabled="{Binding CanUpdate}"
                            FontSize="13" Padding="14,0" HeightRequest="38" CornerRadius="19"
                            BackgroundColor="{StaticResource Primary}" TextColor="White" />
                </Grid>
                <ActivityIndicator IsRunning="{Binding IsChecking}" IsVisible="{Binding IsChecking}" HeightRequest="24"
                                   Color="{StaticResource Primary}" />
            </VerticalStackLayout>

            <Label Text="BỘ NHỚ" Style="{StaticResource Section}" />
            <VerticalStackLayout Style="{StaticResource Card}" Padding="16,12">
                <Label Text="{Binding StorageText}" Style="{StaticResource Name}" FontSize="14" />
            </VerticalStackLayout>

            <Label Text="ỨNG DỤNG" Style="{StaticResource Section}" />
            <VerticalStackLayout Style="{StaticResource Card}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,14">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenAboutCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="{x:Static views:Icons.Info}" FontFamily="Icons" FontSize="22" VerticalOptions="Center"
                           TextColor="{StaticResource Primary}" />
                    <Label Grid.Column="1" Text="Thông tin ứng dụng, điều khoản, bản quyền" Style="{StaticResource Name}" />
                    <Label Grid.Column="2" Text="{x:Static views:Icons.ChevronRight}" FontFamily="Icons" FontSize="22" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}" />
                </Grid>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
