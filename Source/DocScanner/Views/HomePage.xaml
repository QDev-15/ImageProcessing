<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DocScanner.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:DocScanner.ViewModels"
    xmlns:views="clr-namespace:DocScanner.Views"
    x:DataType="vm:HomeViewModel"
    Title="Doc Scanner">

    <Grid RowDefinitions="*,Auto">

        <CollectionView Grid.Row="0" ItemsSource="{Binding Documents}" Margin="16,8,16,0">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                    <Label Text="Chưa có tài liệu nào" FontSize="22" HorizontalOptions="Center" />
                    <Label Text="Chụp hoặc nhập ảnh để bắt đầu quét."
                           HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DocumentItem">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Xoá" BackgroundColor="#D32F2F" Command="{Binding DeleteCommand}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border StrokeThickness="1" Padding="8"
                                Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#444444}"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#222222}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="72,*" ColumnSpacing="12">
                                <Image Source="{Binding Thumb}" WidthRequest="72" HeightRequest="96" Aspect="AspectFill" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                    <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Subtitle}" FontSize="12"
                                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="1" Spacing="10" Padding="16">
            <Button Text="Chụp ảnh" Command="{Binding CaptureCommand}" />
            <Button Text="Nhập từ thư viện" Command="{Binding PickFromGalleryCommand}" />
            <Label Text="{Binding CoreInfo}" FontSize="11" HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#888888, Dark=#777777}" />
        </VerticalStackLayout>

        <views:BusyOverlay Grid.RowSpan="2" />
    </Grid>
</ContentPage>
