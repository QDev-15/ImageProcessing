<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DocScanner.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:DocScanner.ViewModels"
    xmlns:views="clr-namespace:DocScanner.Views"
    x:DataType="vm:HomeViewModel"
    Title="Doc Scanner"
    BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#121212}">

    <Grid RowDefinitions="*,Auto">

        <!-- Documents: compact rows (thumbnail, name, pages · date, ⋮). Swipe left to delete. -->
        <CollectionView Grid.Row="0" ItemsSource="{Binding Documents}">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" Spacing="10" Padding="32">
                    <Label Text="{x:Static views:Icons.Scanner}" FontFamily="Icons" FontSize="64" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#B8C4D6, Dark=#4A5568}" />
                    <Label Text="Chưa có tài liệu nào" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label Text="Bấm nút chụp bên dưới, hoặc nhập ảnh có sẵn."
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" FontSize="13"
                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <!-- 1 px gaps show the page background: hairline separators between rows. -->
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="1" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DocumentItem">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Xoá" BackgroundColor="#D32F2F" Command="{Binding DeleteCommand}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="14" Padding="16,10,4,10"
                              BackgroundColor="{AppThemeBinding Light=White, Dark=#1C1C1E}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand}" />
                            </Grid.GestureRecognizers>
                            <Border WidthRequest="48" HeightRequest="64" StrokeThickness="1" Padding="0"
                                    Stroke="{AppThemeBinding Light=#E2E6EC, Dark=#333333}"
                                    BackgroundColor="{AppThemeBinding Light=#EEF1F5, Dark=#2A2A2A}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="4" />
                                </Border.StrokeShape>
                                <Image Source="{Binding Thumb}" Aspect="AspectFill" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="{Binding Name}" FontSize="15" FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Subtitle}" FontSize="12" LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{x:Static views:Icons.More}" FontFamily="Icons" FontSize="22"
                                   WidthRequest="44" HeightRequest="44" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding MenuCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bottom bar: import · big round capture button · exported PDFs -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" HeightRequest="64" Padding="16,0"
              BackgroundColor="{AppThemeBinding Light=White, Dark=#1C1C1E}">
            <BoxView Grid.ColumnSpan="3" HeightRequest="0.6" VerticalOptions="Start"
                     Color="{AppThemeBinding Light=#E5E7EB, Dark=#2C2C2E}" />
            <views:ToolButton Icon="{x:Static views:Icons.Gallery}" Text="Nhập ảnh" Command="{Binding PickFromGalleryCommand}" />
            <Border Grid.Column="1" WidthRequest="64" HeightRequest="64" StrokeThickness="4" TranslationY="-16"
                    Stroke="{AppThemeBinding Light=White, Dark=#1C1C1E}"
                    BackgroundColor="{StaticResource Primary}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="32" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CaptureCommand}" />
                </Border.GestureRecognizers>
                <Label Text="{x:Static views:Icons.Camera}" FontFamily="Icons" FontSize="30" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <views:ToolButton Grid.Column="2" Icon="{x:Static views:Icons.Pdf}" Text="PDF đã xuất" Command="{Binding OpenExportsCommand}" />
        </Grid>

        <views:ExportOverlay Grid.RowSpan="2" />
    </Grid>
</ContentPage>
