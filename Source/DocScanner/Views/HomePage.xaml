<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DocScanner.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:DocScanner.ViewModels"
    xmlns:views="clr-namespace:DocScanner.Views"
    x:DataType="vm:HomeViewModel"
    Title="{Binding Title}"
    BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#121212}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Tìm kiếm" Command="{Binding ToggleSearchCommand}" Order="Primary">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="Icons" Glyph="{x:Static views:Icons.Search}" Size="24"
                                 Color="{AppThemeBinding Light=#37404D, Dark=#E0E0E0}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem Text="Thư mục mới" Command="{Binding NewFolderCommand}" Order="Primary">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="Icons" Glyph="{x:Static views:Icons.NewFolder}" Size="24"
                                 Color="{AppThemeBinding Light=#37404D, Dark=#E0E0E0}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem Text="Nhập PDF" Command="{Binding PickPdfCommand}" Order="Primary">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="Icons" Glyph="{x:Static views:Icons.Pdf}" Size="24"
                                 Color="{AppThemeBinding Light=#37404D, Dark=#E0E0E0}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem Text="Cài đặt" Command="{Binding OpenSettingsCommand}" Order="Primary">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="Icons" Glyph="{x:Static views:Icons.Settings}" Size="24"
                                 Color="{AppThemeBinding Light=#37404D, Dark=#E0E0E0}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <!-- A folder row: tap to open; drop dragged documents on it to file them there. -->
        <DataTemplate x:Key="FolderRow" x:DataType="vm:FolderItem">
            <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="14" Padding="16,10,4,10"
                  BackgroundColor="{AppThemeBinding Light=White, Dark=#1C1C1E}">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenCommand}" />
                    <DropGestureRecognizer AllowDrop="True" DropCommand="{Binding DropCommand}" />
                </Grid.GestureRecognizers>
                <Label Text="{x:Static views:Icons.FolderFilled}" FontFamily="Icons" FontSize="40" HorizontalOptions="Center"
                       VerticalOptions="Center" TextColor="#F2B53A" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                    <Label Text="{Binding Name}" FontSize="15" FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding Subtitle}" FontSize="12" TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                </VerticalStackLayout>
                <Label Grid.Column="2" Text="{x:Static views:Icons.More}" FontFamily="Icons" FontSize="22"
                       WidthRequest="44" HeightRequest="44" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding MenuCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </DataTemplate>

        <!-- A document row: thumbnail, name, pages · date, ⋮. Swipe left to delete; long press to select / drag. -->
        <DataTemplate x:Key="DocumentRow" x:DataType="vm:DocumentItem">
            <SwipeView>
                <SwipeView.RightItems>
                    <SwipeItems>
                        <SwipeItem Text="Xoá" BackgroundColor="#D32F2F" Command="{Binding DeleteCommand}" />
                    </SwipeItems>
                </SwipeView.RightItems>
                <Grid ColumnDefinitions="Auto,48,*,Auto" ColumnSpacing="14" Padding="16,10,4,10"
                      BackgroundColor="{AppThemeBinding Light=White, Dark=#1C1C1E}">
                    <Grid.Triggers>
                        <DataTrigger TargetType="Grid" Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E8F0FD, Dark=#1B2A44}" />
                        </DataTrigger>
                    </Grid.Triggers>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenCommand}" />
                        <DragGestureRecognizer CanDrag="True" DragStartingCommand="{Binding DragStartingCommand}" />
                    </Grid.GestureRecognizers>
                    <!-- Tick box, only in selection mode -->
                    <Label IsVisible="{Binding IsSelecting}" Text="{x:Static views:Icons.Unchecked}" FontFamily="Icons" FontSize="24"
                           VerticalOptions="Center" TextColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Text" Value="{x:Static views:Icons.Checked}" />
                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Border Grid.Column="1" WidthRequest="48" HeightRequest="64" StrokeThickness="1" Padding="0"
                            Stroke="{AppThemeBinding Light=#E2E6EC, Dark=#333333}"
                            BackgroundColor="{AppThemeBinding Light=#EEF1F5, Dark=#2A2A2A}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="4" />
                        </Border.StrokeShape>
                        <Image Source="{Binding Thumb}" Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="3">
                        <Label Text="{Binding Name}" FontSize="15" FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Subtitle}" FontSize="12" LineBreakMode="TailTruncation"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="3" Text="{x:Static views:Icons.More}" FontFamily="Icons" FontSize="22"
                           WidthRequest="44" HeightRequest="44" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding MenuCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </SwipeView>
        </DataTemplate>

        <views:HomeRowSelector x:Key="RowSelector" Folder="{StaticResource FolderRow}" Document="{StaticResource DocumentRow}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">

        <!-- The very bottom-most strip, flush with the screen edge, below the Chụp / Nhập ảnh / PDF đã xuất bar. -->
        <views:AdBannerView Grid.Row="5" />

        <!-- Selection mode, in place of the bottom bar (the list must not move while a document is being dragged):
             count, select all, move to a folder, delete, done. -->
        <Grid Grid.Row="3" ZIndex="2" HeightRequest="64" IsVisible="{Binding IsSelecting}" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Padding="4,2,4,2"
              BackgroundColor="{AppThemeBinding Light=#E8F0FD, Dark=#1B2A44}">
            <views:ToolButton Icon="{x:Static views:Icons.Close}" Text="" IconSize="24" Command="{Binding EndSelectionCommand}" />
            <Label Grid.Column="1" Text="{Binding SelectionText}" FontSize="15" FontFamily="OpenSansSemibold" VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light=#1E3A6E, Dark=#C9D8F2}" />
            <views:ToolButton Grid.Column="2" Icon="{x:Static views:Icons.SelectAll}" Text="Tất cả" Command="{Binding SelectAllCommand}" />
            <views:ToolButton Grid.Column="3" Icon="{x:Static views:Icons.MoveTo}" Text="Chuyển" Command="{Binding MoveSelectedCommand}" />
            <views:ToolButton Grid.Column="4" Icon="{x:Static views:Icons.Delete}" Text="Xoá" Command="{Binding DeleteSelectedCommand}" />
        </Grid>

        <!-- Search: by name, accents ignored, across all folders. -->
        <SearchBar Grid.Row="1" IsVisible="{Binding IsSearching}" Text="{Binding SearchText}" Placeholder="Tìm theo tên tài liệu, thư mục..."
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#1C1C1E}" x:Name="Search" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource RowSelector}">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" Spacing="10" Padding="32">
                    <Label Text="{x:Static views:Icons.Scanner}" FontFamily="Icons" FontSize="64" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#B8C4D6, Dark=#4A5568}" />
                    <Label Text="Chưa có tài liệu nào" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label Text="{Binding EmptyText}" HorizontalOptions="Center" HorizontalTextAlignment="Center" FontSize="13"
                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <!-- 1 px gaps show the page background: hairline separators between rows. -->
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="1" />
            </CollectionView.ItemsLayout>
        </CollectionView>

        <!-- Bottom bar: import · big round capture button · exported PDFs -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,*" HeightRequest="64" Padding="16,0" IsVisible="{Binding NotSelecting}"
              BackgroundColor="{AppThemeBinding Light=White, Dark=#1C1C1E}">
            <BoxView Grid.ColumnSpan="3" HeightRequest="0.6" VerticalOptions="Start"
                     Color="{AppThemeBinding Light=#E5E7EB, Dark=#2C2C2E}" />
            <views:ToolButton Icon="{x:Static views:Icons.Gallery}" Text="Nhập ảnh" Command="{Binding PickFromGalleryCommand}" />
            <Border Grid.Column="1" WidthRequest="64" HeightRequest="64" StrokeThickness="4" TranslationY="-16"
                    Stroke="{AppThemeBinding Light=White, Dark=#1C1C1E}"
                    BackgroundColor="{StaticResource Primary}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="32" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CaptureCommand}" />
                </Border.GestureRecognizers>
                <Label Text="{x:Static views:Icons.Camera}" FontFamily="Icons" FontSize="30" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <views:ToolButton Grid.Column="2" Icon="{x:Static views:Icons.Pdf}" Text="PDF đã xuất" Command="{Binding OpenExportsCommand}" />
        </Grid>

        <views:ExportOverlay Grid.RowSpan="6" />
    </Grid>
</ContentPage>
