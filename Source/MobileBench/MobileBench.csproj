<Project Sdk="Microsoft.NET.Sdk">

  <!-- Timing of the mobile pipeline's managed stages (edge detection, perspective warp, filters, thumbnail,
       PNG, PDF) on realistic sizes: a 12 MP photo, a 1600 px proxy, an A4 page at 300 DPI.
       Run: dotnet run -c Release (project Source/MobileBench). Platform codecs (JPEG decode / encode on
       Android) are not included: measure those on the device. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocScanner.Core\DocScanner.Core.csproj" />
    <!-- SceneBuilder: synthetic "sheet on a desk" photos. -->
    <ProjectReference Include="..\ImageCore.Shared.Tests\ImageCore.Shared.Tests.csproj" />
  </ItemGroup>

</Project>
