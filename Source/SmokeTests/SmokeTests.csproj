<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless end-to-end checks for ImageCoreService (binarization, cleanup, OCR,
       PDF/A export, splitting...). Run: dotnet run (project Source/SmokeTests)
       Exit code 0 = all PASS. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImageCoreService\ImageCoreService.csproj" />
  </ItemGroup>

</Project>
